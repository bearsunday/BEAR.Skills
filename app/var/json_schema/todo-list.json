{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Todo List Response",
  "type": "object",
  "required": ["todos"],
  "properties": {
    "todos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "completed", "dateCreated"],
        "properties": {
          "id": {
            "description": "The unique identifier for a todo",
            "type": "string",
            "maxLength": 64
          },
          "title": {
            "description": "The title of the todo",
            "type": "string",
            "maxLength": 255
          },
          "completed": {
            "description": "Whether the todo is completed",
            "type": "boolean"
          },
          "dateCreated": {
            "description": "The date and time when the todo was created",
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
