{
    "name": "bear/qatools",
    "description": "QA tools",
    "require-dev": {
        "doctrine/coding-standard": "^14.0",
        "phpmd/phpmd": "^2.10",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0",
        "vimeo/psalm": "^6.13"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/package-versions-deprecated": true
        }
    }
}
